          "name": "POST Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"manuel22\",\n    \"email\": \"manuel@leaguemate.com\",\n    \"password\": \"password123\",\n    \"firstName\": \"Manuel\",\n    \"lastName\": \"Barbagallo\"\n}",
              "options": {
                "raw": {
