    {
      "name": "8. Error Handling",
      "description": "Richieste volutamente errate, per verificare che l'applicazione gestisca gli errori in modo controllato restituendo status code corretti e un formato di risposta coerente.",
      "item": [
        {
          "name": "POST Login - Wrong Password (401)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
