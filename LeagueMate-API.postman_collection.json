            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"utenteInesistente\",\n    \"password\": \"qualsiasi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Username inesistente. Attende 401 con la STESSA risposta del caso precedente: distinguere i due casi permetterebbe di enumerare gli account registrati."
          },
          "response": []
        },
        {
          "name": "GET Tournaments - Malformed JWT (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer token-non-valido",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tournaments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "tournaments"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Token JWT corrotto. L'eccezione nasce nel JwtAuthFilter, prima del DispatcherServlet, quindi non e' intercettabile dal @RestControllerAdvice: viene gestita nel filtro stesso. Attende 401 JSON."
          },
          "response": []
        },
