# Copia questo file in .env (non versionato) e personalizza i valori.
# docker compose legge .env automaticamente.

# Obbligatorio: chiave HS256 in Base64, almeno 32 byte.
# Generala con: openssl rand -base64 32
JWT_SECRET=

JWT_EXPIRATION=86400000

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=leaguemate_db
MYSQL_USER=leaguemate_user
MYSQL_PASSWORD=leaguemate_pass
